# ---- 应用 ----
NODE_ENV=production
APP_NAME=家中物品来历册
# 生成邀请/分享链接用的对外地址，必须与真实访问地址一致
APP_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info
# 构建后由 API 直接托管前端（apps/web/dist）；用 Nginx/Caddy 单独托管时设为 false
SERVE_WEB=true
WEB_DIST=./apps/web/dist

# ---- 数据库 ----
# scripts/pg.sh 用下面三项初始化本地集群；DATABASE_URL 是应用实际连接串，两者保持一致
POSTGRES_USER=heirloom
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=heirloom
# 本机 PostgreSQL（含 scripts/pg.sh 起的本地集群）
DATABASE_URL=postgresql://heirloom:change-me-please@127.0.0.1:5432/heirloom?schema=public
# 远程/托管数据库示例：
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/heirloom?schema=public&sslmode=require

# ---- 认证 ----
# 必填，用 `openssl rand -hex 32` 生成；留空会导致服务启动失败
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
COOKIE_SECURE=false

# ---- 存储 ----
STORAGE_ROOT=./data/uploads
EXPORT_ROOT=./data/exports
BACKUP_ROOT=./data/backups
MAX_IMAGE_MB=25
MAX_AUDIO_MB=200
MAX_DOC_MB=50
# 音频转码与波形生成需要 ffmpeg（macOS: brew install ffmpeg；Debian/Ubuntu: apt install ffmpeg）
# 不在 PATH 里时给出绝对路径，例如 /opt/homebrew/bin/ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 后台任务 ----
WORKER_ENABLED=true
WORKER_POLL_MS=2000
TRASH_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7

# ---- 备份编排与演练中心（apps/ops-center）----
# 定时计划（cron 五字段，按 TZ 解释；缺省：每天 02:30 备份、04:00 校验、每月 1 号 03:00 演练）
BACKUP_CRON=30 2 * * *
VERIFY_CRON=0 4 * * *
DRILL_CRON=0 3 1 * *
# 守护进程重启后发现错过计划窗口时自动补跑
SCHEDULE_CATCHUP=true
# 保留策略：同时超过份数与天数的成功备份才回收（最新一份永不回收）
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
# 校验/演练时的媒体抽样个数（0 表示全量）
VERIFY_SAMPLE_SIZE=50
DRILL_COMPARE_SAMPLE_SIZE=50
# 只读状态面板（只绑定本机；端口 <=0 关闭）
OPS_HTTP_PORT=4097
OPS_HTTP_HOST=127.0.0.1
# pg 客户端二进制不在 PATH 时指定目录（含 psql/pg_dump/pg_restore/createdb）
# PG_BIN_PATH=/usr/lib/postgresql/16/bin

# ---- 可选 ----
PUBLIC_SIGNUP=false
TZ=Asia/Shanghai
